
import pandas as pd

# Step 1: Create the dataset
data = {
    "Advertising_Cost": [1, 2, 3, 4, 5],
    "Sales": [12, 15, 19, 20, 26]
}

df = pd.DataFrame(data)
print("Advertising Dataset:")
print(df)

# Step 2: Select input and output
x = df["Advertising_Cost"]
y = df["Sales"]

# Step 3: Calculate the mean
x_mean = x.mean()
y_mean = y.mean()

# Step 4: Calculate the slope
slope = sum((x - x_mean) * (y - y_mean)) / sum((x - x_mean) ** 2)

print("\nSlope:", round(slope, 2))

# Step 5: Calculate intercept
intercept = y_mean - slope * x_mean

# Step 6: Predict sales
predicted = intercept + slope * x

# Step 7: Calculate residual error
error = y - predicted

# Step 8: Display results
print("\nActual Sales:", y.iloc[0])
print("Predicted Sales:", round(predicted.iloc[0], 2))
print("Residual Error:", round(error.iloc[0], 2))
